  <library_effects>
    <effect id="Effect_AdvertisementSeat">
      <profile_COMMON>
        <newparam sid="surface_AdvertisementSeat-diffuse">
          <surface type="2D">
            <init_from>AdvertisementSeat_Alb</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_AdvertisementSeat-diffuse">
          <sampler2D>
            <source>surface_AdvertisementSeat-diffuse</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
          </sampler2D>
        </newparam>
        <newparam sid="surface_AdvertisementSeat-bump">
          <surface type="2D">
            <init_from>AdvertisementSeat_Nrm</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_AdvertisementSeat-bump">
          <sampler2D>
            <source>surface_AdvertisementSeat-bump</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <phong>
            <diffuse>
              <texture texture="sampler_AdvertisementSeat-diffuse" texcoord="CHANNEL0" />
            </diffuse>
            <bump>
              <texture texture="sampler_AdvertisementSeat-bump" texcoord="CHANNEL0" />
            </bump>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <specular>
              <color sid="specular">0 0 0 1</color>
            </specular>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
