  <library_effects>
    <effect id="Effect_AirDancer">
      <profile_COMMON>
        <newparam sid="surface_AirDancer-bump">
          <surface type="2D">
            <init_from>AirDancer_Nrm</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_AirDancer-bump">
          <sampler2D>
            <source>surface_AirDancer-bump</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
          </sampler2D>
        </newparam>
        <newparam sid="surface_AirDancer-diffuse">
          <surface type="2D">
            <init_from>AirDancer_Alb</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_AirDancer-diffuse">
          <sampler2D>
            <source>surface_AirDancer-diffuse</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <phong>
            <bump>
              <texture texture="sampler_AirDancer-bump" texcoord="CHANNEL0" />
            </bump>
            <diffuse>
              <texture texture="sampler_AirDancer-diffuse" texcoord="CHANNEL0" />
            </diffuse>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <specular>
              <color sid="specular">0 0 0 1</color>
            </specular>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="Effect_BGLeaf">
      <profile_COMMON>
        <newparam sid="surface_BGLeaf-diffuse">
          <surface type="2D">
            <init_from>BGLeaf_Alb</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_BGLeaf-diffuse">
          <sampler2D>
