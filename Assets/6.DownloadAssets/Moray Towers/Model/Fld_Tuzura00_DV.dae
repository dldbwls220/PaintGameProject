  <library_effects>
    <effect id="Effect_BackgroundBuildings">
      <profile_COMMON>
        <newparam sid="surface_BackgroundBuildings-diffuse">
          <surface type="2D">
            <init_from>BackgroundBuildings_Alb</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_BackgroundBuildings-diffuse">
          <sampler2D>
            <source>surface_BackgroundBuildings-diffuse</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
          </sampler2D>
        </newparam>
        <newparam sid="surface_BackgroundBuildings-emission">
          <surface type="2D">
            <init_from>BackgroundBuildings_Emm</init_from>
            <format>A8R8G8B8</format>
          </surface>
        </newparam>
        <newparam sid="sampler_BackgroundBuildings-emission">
          <sampler2D>
            <source>surface_BackgroundBuildings-emission</source>
            <wrap_s>WRAP</wrap_s>
            <wrap_t>WRAP</wrap_t>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <phong>
            <diffuse>
              <texture texture="sampler_BackgroundBuildings-diffuse" texcoord="CHANNEL0" />
            </diffuse>
            <emission>
              <texture texture="sampler_BackgroundBuildings-emission" texcoord="CHANNEL0" />
            </emission>
            <specular>
              <color sid="specular">0 0 0 1</color>
            </specular>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
